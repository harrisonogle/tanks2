<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Tanks.Discovery</AssemblyName>
    <RootNamespace>Tanks.Net</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <DefineConstants>$(DefineConstants);NOT_UNITY</DefineConstants>
    <NoWarn>$(NoWarn);CS0164</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Protocol\src\Tanks.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Assets\Tanks\Discovery\**\*.cs">
      <Link>Discovery\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
