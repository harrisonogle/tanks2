<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Tanks.Protocol</AssemblyName>
    <RootNamespace>Tanks.Net</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <DefineConstants>$(DefineConstants);NOT_UNITY</DefineConstants>
    <NoWarn>$(NoWarn);CS0164</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".unused" Label="these are mostly comprised of components that are good, just not necessary. ready to fold back in if needed" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Assets\Tanks\Protocol\**\*.cs">
      <Link>Protocol\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
